# ==============================================================================
# CVO Geo-Tagging Livestock Dispersal System — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ==============================================================================

# Django secret key — generate a new one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me-to-a-random-50-char-string

# Debug mode — MUST be False in production
DJANGO_DEBUG=False

# Comma-separated list of allowed hostnames
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database URL — SQLite for dev, Postgres for staging/prod
# Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=sqlite:///db.sqlite3

# Media file storage root (relative to project root)
MEDIA_ROOT=media

# CORS origins — comma-separated list of frontend URLs
CORS_ALLOWED_ORIGINS=http://localhost:5173

# JWT token lifetimes
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ---------- Optional: PostGIS (for spatial queries) ----------
# Uncomment and set if using PostGIS instead of plain Postgres
# DATABASE_URL=postgis://USER:PASSWORD@HOST:PORT/DBNAME

# ---------- Optional: Celery (for background tasks) ----------
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ---------- Optional: Email (for notifications) ----------
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
